# Cybos Bridge Connection Info
CYBOS_BRIDGE_HOST=127.0.0.1
CYBOS_BRIDGE_PORT=8032

# API Keys (If using external services)
# EXTERNAL_API_KEY=your_api_key_here

# Logging Configuration
LOG_LEVEL=INFO

# 1. .gitignore 및 .env.example 생성
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv
venv/
ENV/
.env
logs/
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db
*.sqlite3
*.db

# 2. Git 초기화 및 원격 연결 (기존 설정이 있으면 무시하고 새로 등록)
git init
git remote add origin https://github.com/hoonoh57/smart-money.git 2>$null || git remote set-url origin https://github.com/hoonoh57/smart-money.git

# 3. 커밋 및 푸시
git add .
git commit -m "feat: complete smart-money cockpit with optimized bridge and dashboard"
git branch -M main
git push -u origin main
